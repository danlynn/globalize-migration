class <%= migration_class_name %> < ActiveRecord::Migration[<%= ActiveRecord::Migration.current_version %>]
  # Created by the globalize-migration gem
<%-
  # String/text columns whose name matches one of these words -- as the whole
  # name or an "_"-delimited suffix (e.g. "url" or "image_url") -- are treated
  # as NOT locale-specific and kept on the main table instead of being moved to
  # the translations table.
  untranslatable_names = %w[url uri path website email phone locale color timezone code key domain host]
  untranslatable_re = /(?:\A|_)(?:#{untranslatable_names.join("|")})\z/

  translatable = lambda do |attribute|
    !attribute.password_digest? && !attribute.token? && !attribute.reference? &&
      (!attribute.respond_to?(:virtual?) || !attribute.virtual?) &&
      (attribute.type == :string || attribute.type == :text) &&
      attribute.name.to_s !~ untranslatable_re
  end

  translated_attributes = attributes.select { |attribute| translatable.call(attribute) }

  kept_on_main = attributes.select do |attribute|
    (attribute.type == :string || attribute.type == :text) &&
      !attribute.password_digest? && !attribute.token? && !attribute.reference? &&
      (!attribute.respond_to?(:virtual?) || !attribute.virtual?) &&
      attribute.name.to_s =~ untranslatable_re
  end

  # Only MySQL understands the ENGINE/CHARSET table options, so emit them only
  # when generating against a MySQL adapter (keeps this gem adapter-portable).
  # This forces the tables to utf8mb4 rather than inheriting the DB default,
  # which on legacy databases can be latin1 and cannot store many Unicode chars.
  mysql_adapter = begin
    ActiveRecord::Base.connection.adapter_name.to_s =~ /mysql/i ? true : false
  rescue StandardError
    false
  end
  table_options_clause = mysql_adapter ? ", options: 'ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci'" : ""
-%>
  def change
<% if kept_on_main.any? -%>
    # Kept on the main table (non-translatable name pattern): <%= kept_on_main.map(&:name).join(", ") %>
<% end -%>
    create_table :<%= table_name %><%= primary_key_type %><%= table_options_clause %> do |t|
<% if options[:timestamps] -%>
      t.timestamps
<% end -%>
<% attributes.each do |attribute| -%>
<% if attribute.password_digest? -%>
      t.string :password_digest<%= attribute.inject_options %>
<% elsif attribute.token? -%>
      t.string :<%= attribute.name %><%= attribute.inject_options %>
<% elsif attribute.reference? -%>
<%# `foreign_key_type` only exists on the generator from Rails 6 onward. On
    Rails 5.2 calling it raises NameError and the whole generate fails, so
    guard it rather than assuming. `inject_options` already carries
    `polymorphic: true` and friends. -%>
      t.<%= attribute.type %> :<%= attribute.name %><%= attribute.inject_options %><%= respond_to?(:foreign_key_type) ? foreign_key_type : "" %>
<% elsif (!attribute.respond_to?(:virtual?) || !attribute.virtual?) && !translatable.call(attribute) -%>
      t.<%= attribute.type %> :<%= attribute.name %><%= attribute.inject_options %>
<% end -%>
<% end -%>
    end

<% if translated_attributes.any? -%>
    create_table :<%= singular_table_name %>_translations<%= primary_key_type %><%= table_options_clause %> do |t|
<% if options[:timestamps] -%>
      t.timestamps
<% end -%>
      t.integer :<%= singular_table_name %>_id
      t.string :locale
<% translated_attributes.each do |attribute| -%>
      t.<%= attribute.type %> :<%= attribute.name %><%= attribute.inject_options %>
<% end -%>
    end
<% end -%>
<% attributes.select(&:token?).each do |attribute| -%>
    add_index :<%= table_name %>, :<%= attribute.index_name %><%= attribute.inject_index_options %>, unique: true
<% end -%>
<% attributes_with_index.each do |attribute| -%>
<% if translatable.call(attribute) -%>
    add_index :<%= singular_table_name %>_translations, :<%= attribute.index_name %><%= attribute.inject_index_options %>
<% else -%>
    add_index :<%= table_name %>, :<%= attribute.index_name %><%= attribute.inject_index_options %>
<% end -%>
<% end -%>
  end
end
